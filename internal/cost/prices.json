  "assumptions": [
    {
      "code": "api-equivalent",
      "text": "An estimate of what the same usage would cost at the providers' public API list prices. It is not what was billed, nor money saved."
    },
    {
      "code": "list-prices",
      "text": "Standard list prices: no batch, volume or negotiated discount."
    },
    {
      "code": "global-inference",
      "text": "Global inference: no data-residency or regional multiplier."
    },
    {
      "code": "server-tools-not-reported",
      "text": "The runners' telemetry does not report server-side tool use (web search), so its per-use charges are not included."
    },
    {
      "code": "failed-requests-unbilled",
      "text": "A failed request is counted but not priced: it reports no tokens."
    },
    {
      "code": "codex-input-includes-cache",
      "text": "Codex's input count includes its cached and (inferred) cache-write input; uncached input is what remains."
    },
    {
      "code": "standard-tier-by-default",
      "text": "A request that reports no speed or service tier is priced at the standard tier."
    }
  ],
